{
  "name": "isaac-achievement-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Local web application that reads your progress in The Binding of Isaac: Rebirth and plans what is left to unlock.",
  "license": "MIT",
  "author": "JustMordeckai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustMordeckai/isaac-achievement-manager.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.ts --dev",
    "build": "vite build",
    "start": "node server/index.ts --open",
    "stop": "node server/stop.ts",
    "sync-wiki": "node server/wiki/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
